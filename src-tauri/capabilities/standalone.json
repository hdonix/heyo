{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "standalone",
  "description": "The settings window and pinned captures draw their own frame: they close and drag themselves.",
  "windows": [
    "settings",
    "pin-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
